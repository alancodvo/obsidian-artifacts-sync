{
  "name": "obsidian-artifacts-sync",
  "version": "0.4.2",
  "description": "Sync your Obsidian vault (or a folder in it) with a Cloudflare Artifacts repository.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "e2e": "node --no-deprecation --import tsx scripts/e2e.ts",
    "e2e:api": "node --no-deprecation --import tsx scripts/e2e-api.ts",
    "e2e:mobile": "node --no-deprecation --import tsx scripts/e2e-mobile.ts",
    "e2e:bundle": "node --no-deprecation --import tsx scripts/e2e-bundle.ts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "cloudflare",
    "artifacts",
    "git",
    "sync"
  ],
  "author": "KOIYAL",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "isomorphic-git": "^1.43.3"
  }
}
